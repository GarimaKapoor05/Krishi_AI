# ---------------------------------------------------------------------------
# KrishiAI backend environment variables (example)
# Copy to `.env` and fill in real values. NEVER commit a real `.env`.
# ---------------------------------------------------------------------------

# Flask session + JWT secrets (change these in production)
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# Port the Flask app listens on
PORT=5000

# Comma-separated deployed frontend origins allowed to call this backend.
# Local development origins are included in Backend/app.py.
CORS_ALLOWED_ORIGINS=

# Database. Leave blank to use local SQLite (Backend/instance/krishiai.db).
# For Postgres, set e.g. postgresql://user:pass@host:5432/dbname
DATABASE_URL=

# ---------------------------------------------------------------------------
# Market Intelligence (optional)
# ---------------------------------------------------------------------------
# Free key from https://data.gov.in . Required for LIVE AGMARKNET mandi prices.
# Without it, no live nationwide mandi quotes can be returned. With live mode
# enabled below, the API does not substitute bundled sample prices. Weather
# (Open-Meteo) is keyless.
DATA_GOV_API_KEY=
MARKET_DATA_MODE=live

# For deployments with ephemeral containers, mount a persistent disk and set
# UPLOAD_DIR to its writable path so farmer photos survive restarts/redeploys.
UPLOAD_DIR=

# Keep live price snapshots on the same persistent deployment volume when
# historical trends and forecasts should survive container restarts.
MARKET_SNAPSHOT_PATH=

# ---------------------------------------------------------------------------
# Contact form email delivery (backend only)
# Copy these values into Backend/.env or the backend host's secret settings.
# For Gmail, use an App Password for SMTP_PASSWORD (never your normal password).
# The recipient defaults to the project contact inbox below.
# ---------------------------------------------------------------------------
CONTACT_TO_EMAIL=amitmehta0716@gmail.com
CONTACT_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
