# ---------------------------------------------------------------------------
# KrishiAI backend environment variables (example)
# Copy to `.env` and fill in real values. NEVER commit a real `.env`.
# ---------------------------------------------------------------------------

# Flask session + JWT secrets (change these in production)
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# Port the Flask app listens on
PORT=5000

# Database. Leave blank to use local SQLite (Backend/instance/krishiai.db).
# For Postgres, set e.g. postgresql://user:pass@host:5432/dbname
DATABASE_URL=

# ---------------------------------------------------------------------------
# Market Intelligence (optional)
# ---------------------------------------------------------------------------
# Free key from https://data.gov.in . Required for LIVE AGMARKNET mandi prices.
# Without it, the Market Intelligence module falls back to the bundled
# historical sample dataset (Madhya Pradesh, 2023). Weather (Open-Meteo) is
# keyless and always works.
DATA_GOV_API_KEY=579b464db66ec23bdd000001a7e21b4765d741bf42222552b814e86c
